# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.

# Endereço e porta publicados no host. 127.0.0.1 = só esta máquina (recomendado com proxy HTTPS na frente).
MEDUSA_BIND=127.0.0.1
MEDUSA_PUBLISH_PORT=8765

# Administrador criado na primeira subida (ignorado se já existir um administrador).
MEDUSA_ADMIN_LOGIN=admin
MEDUSA_ADMIN_NAME=Administrador
# Deixe vazio para gerar uma senha temporária (aparece no log). A troca é obrigatória no primeiro acesso.
MEDUSA_ADMIN_PASSWORD=

# 1 quando os usuários acessarem por HTTPS (proxy reverso). Com 1, o login não funciona por http://
MEDUSA_SECURE_COOKIES=0

# 1 atrás de proxy reverso: usa o IP real do usuário (X-Forwarded-For) na auditoria e no bloqueio de login.
MEDUSA_TRUST_PROXY=0
